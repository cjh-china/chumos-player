<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SimpleMusic">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".NowPlayingActivity"
            android:exported="false"
            android:theme="@style/Theme.SimpleMusic" />

        <activity android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SimpleMusic" />

        <activity android:name=".HistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.SimpleMusic"
            android:launchMode="singleTop" />

        <activity android:name=".PlaylistActivity"
            android:exported="false"
            android:theme="@style/Theme.SimpleMusic" />

        <activity android:name=".RemoteMusicActivity"
            android:exported="false"
            android:theme="@style/Theme.SimpleMusic" />

        <activity android:name=".SmbActivity"
            android:exported="false"
            android:theme="@style/Theme.SimpleMusic" />

        <activity android:name=".FavoritesActivity"
            android:exported="false"
            android:theme="@style/Theme.SimpleMusic" />

        <activity android:name=".StatsActivity"
            android:exported="false"
            android:label="@string/stats_title"
            android:theme="@style/Theme.SimpleMusic" />

        <activity android:name=".SmartPlaylistActivity"
            android:exported="false"
            android:label="@string/mine_smart_title"
            android:theme="@style/Theme.SimpleMusic" />

        <!-- ==================== 对外接口：文本 → 音频 ====================
             exported=true，允许其他 App 通过 Intent 把文本交给初墨合成并朗读。
             契约见 README「对外接口（文本转音频）」与 TextToAudioActivity 常量。
             只接收纯文本，输出一律写入应用私有目录，不接受外部路径，避免越权写入。 -->
        <activity
            android:name=".TextToAudioActivity"
            android:exported="true"
            android:label="@string/tts_process_label"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.SimpleMusic">

            <!-- 1) 系统分享：任意 App「分享 → 朗读文本」 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 2) 选中文字的上下文菜单（Android 6.0+）：「朗读文本」 -->
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- 3) 显式 API：第三方 App 直接 startActivity -->
            <intent-filter>
                <action android:name="com.chumosplayer.action.SPEAK_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".playback.PlayService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".FloatingLyricsService"
            android:exported="false" />

        <!-- 桌面音乐小组件 -->
        <receiver
            android:name=".widget.MusicWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/music_widget_info" />
        </receiver>
    </application>

</manifest>
