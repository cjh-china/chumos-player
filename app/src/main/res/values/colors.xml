<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ============================================================
         初墨播放器 · 设计系统色板
         60-30-10：60% 中性背景 / 30% 卡片表面 / 10% 主题强调色
         所有正文色对比度按 WCAG 2.1 AA (>=4.5:1) 校验
         ============================================================ -->

    <!-- 品牌主色（靛蓝）10 级色阶：供强调、容器、按下态使用 -->
    <color name="indigo_50">#EDF0FC</color>
    <color name="indigo_100">#D6DCF6</color>
    <color name="indigo_200">#AEB9EE</color>
    <color name="indigo_300">#8595E3</color>
    <color name="indigo_400">#5D6FD0</color>
    <color name="indigo_500">#3F51B5</color>
    <color name="indigo_600">#3547A6</color>
    <color name="indigo_700">#2A3A8C</color>
    <color name="indigo_800">#1F2B6E</color>
    <color name="indigo_900">#141D4E</color>

    <!-- 原有兼容色（勿删：旧布局与代码仍引用） -->
    <color name="primary">#3F51B5</color>
    <color name="primary_dark">#303F9F</color>
    <!-- 强调色（CTA / 进度 / 选中态）：与 colorPrimary 分开，深色模式下独立提亮 -->
    <color name="accent_active">#3F51B5</color>
    <color name="accent">#FF4081</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="lyric_highlight">#3F51B5</color>
    <color name="lyric_normal">#6B7180</color>

    <!-- 语义色 · 浅色模式 -->
    <color name="app_bg">#F5F6FA</color>              <!-- 60% 主导背景 -->
    <color name="mini_bg">#FFFFFF</color>             <!-- 兼容旧名 -->
    <color name="app_card">#FFFFFF</color>            <!-- 30% 卡片表面 -->
    <color name="surface_variant">#EBEDF4</color>     <!-- 次级容器 / 输入框 -->
    <color name="text_primary">#191C25</color>        <!-- on #F5F6FA = 16.6:1 -->
    <color name="text_secondary">#5D6472</color>      <!-- on #F5F6FA = 6.1:1 -->
    <color name="text_tertiary">#7E8595</color>       <!-- 仅用于辅助文字 -->
    <color name="icon_tint">#5D6472</color>           <!-- 矢量图标默认着色，随深浅切换 -->
    <color name="divider">#E4E7EF</color>
    <color name="on_accent">#FFFFFF</color>
    <color name="scrim">#66000000</color>

    <!-- 功能色 -->
    <color name="success">#2E8B66</color>
    <color name="warning">#C9822B</color>
    <color name="error">#C94040</color>
    <color name="favorite">#E4486B</color>

    <!-- 主题色容器（强调色的 8~12% 淡化版，用于选中态 / 图标底板） -->
    <color name="soft_indigo">#E9ECFA</color>
    <color name="soft_rose">#FCE8EF</color>
    <color name="soft_mint">#E1F2EF</color>
    <color name="soft_violet">#EEE8FE</color>
    <color name="soft_amber">#FFF1DC</color>
    <color name="soft_green">#E6F3E7</color>

    <!-- AMOLED 纯黑 -->
    <color name="app_bg_amoled">#000000</color>
    <color name="app_card_amoled">#0C0C0C</color>

    <!-- 自定义主题色：每套 = 主色 / 深色 / 高亮 -->
    <color name="th_rose_p">#D81B60</color>
    <color name="th_rose_d">#AD1457</color>
    <color name="th_rose_a">#FF80AB</color>

    <color name="th_mint_p">#00897B</color>
    <color name="th_mint_d">#00695C</color>
    <color name="th_mint_a">#64FFDA</color>

    <color name="th_violet_p">#6C40E0</color>
    <color name="th_violet_d">#5527C4</color>
    <color name="th_violet_a">#B388FF</color>

    <color name="th_amber_p">#E08200</color>
    <color name="th_amber_d">#B86600</color>
    <color name="th_amber_a">#FFD180</color>

    <color name="th_green_p">#2E8B57</color>
    <color name="th_green_d">#23704A</color>
    <color name="th_green_a">#A5D6A7</color>
</resources>
